+    sd::Tensor<float> encode_svd_conditioning_latent(const sd::Tensor<float>& x) {
+        // SVD conditions the UNet with the deterministic VAE posterior mode.
+        // Unlike diffusion latents, this value is intentionally not multiplied
+        // by the VAE scaling factor (matching StableVideoDiffusionPipeline).
+        auto moments = first_stage_model->encode(n_threads,
+                                                 x,
+                                                 vae_tiling_params,
+                                                 circular_x,
+                                                 circular_y);
+        if (moments.empty()) {
+            return {};
+        }
+        auto posterior = sd::ops::chunk(moments, 2, 2);
+        return posterior.empty() ? sd::Tensor<float>() : std::move(posterior[0]);
+    }
